# The production Worker receives public configuration from wrangler.jsonc.
# These values support local Worker and legacy server development.
WORLD_APP_ID=app_d25e6e3d21651abfb9fbc52d033ef2a3
WORLD_RP_ID=rp_79ffdf898662dd4c
WORLD_RP_SIGNING_KEY=0xyour_private_signing_key
WORLD_ENVIRONMENT=production

# Independent random 32-byte base64 secrets for encrypted state and opaque subjects.
DATA_ENCRYPTION_KEY=replace_with_32_random_bytes_in_base64
SUBJECT_HMAC_KEY=replace_with_a_different_32_random_bytes_in_base64

# Human Required Shopify Dev Dashboard app. Keep the client secret private.
# Required app scopes: read_products, write_discounts.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2026-07
SHOPIFY_CLIENT_ID=replace_with_shopify_client_id
SHOPIFY_CLIENT_SECRET=replace_with_shopify_client_secret

# Legacy verification-link server only.
PUBLIC_BASE_URL=http://localhost:8787
WORLD_ACTION=register

PORT=8787
VERIFICATION_TTL_SECONDS=600
