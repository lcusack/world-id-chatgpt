{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "world-id-chatgpt",
  "account_id": "8831a5679194f781addc25baa0a0bd46",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "WORLD_APP_ID": "app_d25e6e3d21651abfb9fbc52d033ef2a3",
    "WORLD_RP_ID": "rp_79ffdf898662dd4c",
    "WORLD_ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://world-id-chatgpt.foundry-world.workers.dev",
    "HUMAN_REQUIRED_ORIGIN": "https://humanrequired.shop",
    "SHOPIFY_ADMIN_API_VERSION": "2026-07"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "world-id-chatgpt",
      "database_id": "dbf97bfa-b5f8-466f-a754-ee7c09a9e427",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "7b7d342525a44f66bbaf8025e29f684b"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "PROOF_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "WALL_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "CLAIM_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "INTENT_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "GRANT_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
